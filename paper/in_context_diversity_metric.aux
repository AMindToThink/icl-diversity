\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Pairwise cross-mode surprise reduction matrices. Each cell $(i,j)$ shows how many bits of surprise reduction mode $i$ (target) receives from seeing mode $j$ (context). Qwen shows diagonal dominance with pervasive positive off-diagonal (+1.9{} bits mean); GPT-2 shows diagonal dominance with negative off-diagonal (-3.7{} bits mean).}}{12}{figure.caption.16}\protected@file@percent }
\newlabel{fig:pairwise-matrices}{{4}{12}{Pairwise cross-mode surprise reduction matrices. Each cell $(i,j)$ shows how many bits of surprise reduction mode $i$ (target) receives from seeing mode $j$ (context). Qwen shows diagonal dominance with pervasive positive off-diagonal (\crossmodeQwenOffMean {} bits mean); GPT-2 shows diagonal dominance with negative off-diagonal (\crossmodeGPTOffMean {} bits mean)}{figure.caption.16}{}}
