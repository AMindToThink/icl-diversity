\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Predicted (from pairwise matrix, assuming independence) vs.\ observed cumulative surprise drop at $m=10$. The independent model overpredicts by $10.6\times $, demonstrating that pairwise contributions are not additive: information saturates rapidly with context length.}}{13}{figure.caption.19}\protected@file@percent }
\newlabel{fig:predicted-observed}{{5}{13}{Predicted (from pairwise matrix, assuming independence) vs.\ observed cumulative surprise drop at $m=10$. The independent model overpredicts by $\crossmodeAddOverpredRatioMten \times $, demonstrating that pairwise contributions are not additive: information saturates rapidly with context length}{figure.caption.19}{}}
