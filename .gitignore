.env
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
*.egg
.pytest_cache/
.ruff_cache/

# Large sidecar JSON caches (regenerable via --migrate-from-sidecars)
results/tevet/**/*.icl_curves.*.json
diversity-eval/data/with_metrics/**/*.icl_curves.json

# Keep mean curves (small, needed for offline sigmoid refitting)
!results/tevet/**/*.icl_mean_curves.*.json

# LaTeX build artifacts. All are regenerated by latexmk on every build.
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.fdb_latexmk
paper/*.fls
paper/*.log
paper/*.out
paper/*.synctex.gz
# Same patterns under paper/archive/ for the archived original paper.
paper/archive/*.aux
paper/archive/*.bbl
paper/archive/*.blg
paper/archive/*.fdb_latexmk
paper/archive/*.fls
paper/archive/*.log
paper/archive/*.out
paper/archive/*.synctex.gz

# Preview PDF built by `latexmk paper/rlhf_experiment_preview.tex` — it's
# purely a build artifact for verifying the standalone RLHF section
# compiles; keep the final committed PDF only for the main paper.
paper/rlhf_experiment_preview.pdf

# pdftotext-style plaintext dumps of the paper (stale the moment they're
# written; regenerable with `pdftotext paper/main_icml_workshop.pdf`)
paper/*.txt
paper/archive/*.txt

# stdout captures from `uv run python scripts/compute_icl_metrics_for_tevet.py`
# (HTTP traffic + progress bars; kept locally if the user wants to scroll back,
# not worth committing)
compute_v*.log

# Claude Code session state (plans, worktree metadata, etc.) — entirely
# local to this machine; should not be tracked.
.claude/

# Git worktrees (per-branch isolated workspaces, e.g. .worktrees/workshop-icml2026)
.worktrees/

# Per-paper rebuild lock files created by .claude-tools/rebuild-latex.py
# (used to serialize concurrent latexmk invocations on the same paper).
.*.tex.rebuild.lock
